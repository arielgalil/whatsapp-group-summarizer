[Unit]
Description=WhatsApp Group Summarizer (server + web dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change User and the two paths below to your own user and install folder
User=pi
WorkingDirectory=/home/pi/whatsapp-summarizer
ExecStart=/usr/bin/env node --experimental-global-webcrypto server.js
# The dashboard listens on this machine only. To reach it from other devices on your network, uncomment the next
# line AND set a dashboard password straight away (README, Security).
#Environment=HOST=0.0.0.0
Restart=always
RestartSec=10
# Give the server time to save its files before it is stopped (see README, "Restarts")
TimeoutStopSec=30
Nice=15
# Hardening: no privilege escalation, private /tmp, read-only system folders
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
